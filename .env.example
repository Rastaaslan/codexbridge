# Set an absolute path so CLI, server and plugin use the same database.
# CODEXBRIDGE_HOME=C:/codexbridge/.codexbridge
# Optional token override; otherwise setup generates a random local token.
# CODEXBRIDGE_TOKEN=
# Only for reviewer: openai (the default reviewer uses a separate Codex thread).
# OPENAI_API_KEY=
# Secure MCP Tunnel runtime key; never use an admin key here.
# CONTROL_PLANE_API_KEY=
