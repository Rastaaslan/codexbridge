[Unit]
Description=Restore interrupted CodexBridge activation before boot
Before=codexbridge.service

[Service]
Type=oneshot
User=codexbridge
Group=codexbridge
Environment=HOME=/var/lib/codexbridge
Environment=CODEXBRIDGE_HOME=/var/lib/codexbridge
ExecStart=/usr/bin/node /usr/local/lib/codexbridge/self-update.mjs --recover
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal
