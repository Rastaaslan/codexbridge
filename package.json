{
  "name": "codexbridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persistent local-first ChatGPT to Codex orchestration",
  "bin": {
    "codexbridge": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "setup": "npm run build && node dist/cli.js setup",
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "doctor": "node dist/cli.js doctor",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/live-e2e.ts",
    "test:live-recovery": "npm run build && tsx scripts/live-recovery.ts",
    "format": "prettier --write src tests scripts public plugins docs .github *.json *.md *.yaml",
    "format:check": "prettier --check src tests scripts public plugins docs .github *.json *.md *.yaml",
    "check": "npm run build && npm test",
    "audit:publication": "node scripts/audit-publication.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
